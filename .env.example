# Sanity project — create a free project at https://www.sanity.io/manage
# and copy its Project ID here. See README.md "Connect Sanity" section.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# A token with "Editor" permissions, used only by scripts/seed.ts (server-side,
# never exposed to the browser). Create one under API > Tokens in the same
# Sanity project.
SANITY_API_TOKEN=

# Optional: enables the contact form to send real emails via Resend
# (https://resend.com). Without this, the form falls back to opening the
# visitor's email client with a pre-filled message — zero config required.
RESEND_API_KEY=
